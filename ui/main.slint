import {GroupBox, LineEdit, Button} from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "ArpScan-rs-slint";
    width: 400px;
    height: 500px;

    VerticalLayout { 
        alignment:start;
        padding-left: 25px;
        padding-right: 25px;

        Text { 
            font-size: 27px;
            font-weight: 700;
            color: #6776FF;  
        }

        GroupBox{
            title:"CIDR";
            LineEdit {
                placeholder-text: "192.168.1.0/24";
            }
        }

        Button {
            text: "Scan";
        }

    }
}